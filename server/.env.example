# Servidor
PORT=3000
NODE_ENV=development

# Mobile app (usado para deep links em emails, ex: ativação de conta)
APP_SCHEME=zaplist

# Banco de dados (PostgreSQL)
PGDATABASE=zaplist
PGUSER=postgres
PGPASSWORD=
# 5433, não 5432: o docker-compose na raiz do projeto mapeia a porta 5433 do
# host para evitar conflito com um Postgres nativo que já possa estar rodando.
PGHOST=localhost
PGPORT=5433

# JWT — gere valores com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_PEPPER=

# E-mail (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=zaplistbusiness@gmail.com

# CORS — origens permitidas (separadas por vírgula). Apps mobile nativos não enviam
# Origin, então isso protege apenas contra abuso via navegador/emulador.
CORS_ALLOWED_ORIGINS=http://localhost:8081
